# ---- Banco (Neon) ----
# Na Vercel, a integração Neon preenche estas duas automaticamente (Production e Preview com branches separados).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lastfinance
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/lastfinance

# URL pública canônica (define o rpID das passkeys). Em preview, é derivada de VERCEL_URL.
APP_URL=http://localhost:3000

# ---- Segurança ----
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32   (exatamente 32 bytes)
DATA_ENCRYPTION_KEY=
# Token de uso único para criar o usuário em /setup. Remova depois de criar.
SETUP_TOKEN=

# ---- Pluggy ----
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo enviado pela Pluggy no header x-lastfinance-webhook-secret (openssl rand -hex 32)
PLUGGY_WEBHOOK_SECRET=
# Opcional: IPs permitidos para o webhook, separados por vírgula (a Pluggy usa 52.67.145.81)
PLUGGY_WEBHOOK_IP_ALLOWLIST=
# true = usa um banco Pluggy falso, com dados sintéticos (desenvolvimento/testes sem credenciais)
PLUGGY_FAKE=false

# ---- Fila ----
# inngest (produção) | inline (executa na hora, útil para dev/testes)
JOBS_MODE=inngest
# Preenchidas pela integração Inngest na Vercel
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Dev: INNGEST_DEV=1 e rode `npx inngest-cli@latest dev`

# ---- Vercel Cron ----
CRON_SECRET=

# ---- IA (Anthropic) ----
# Sem chave, a categorização usa só regras e o cache de estabelecimentos.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# true = IA falsa (dev/testes, sem custo)
AI_FAKE=false
# Assistente (chat): modelo e teto mensal em dólares
AGENT_MODEL=claude-opus-5-5
AGENT_MONTHLY_BUDGET_USD=10
# Alertas por Web Push: gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@example.com

{
  "name": "lastfinance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "pluggy:probe": "tsx scripts/pluggy-probe.ts",
    "pluggy:webhook": "tsx scripts/register-webhook.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/functions": "3.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "inngest": "4.24.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pluggy-sdk": "0.92.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pluggy-connect": "2.12.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.6",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
